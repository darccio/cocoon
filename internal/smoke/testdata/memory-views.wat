(module
  (import "env" "touch" (func $touch (param i32)))
  (memory (export "memory") 1 4)
  (global $stack (export "stack") (mut i32) (i32.const 49152))
  (data (i32.const 32) "\11\22\33\44\55\66\77\88")

  (func (export "stack_value") (result i32) (global.get $stack))
  (func (export "seed64") (param $p i32) (param $value i64)
    (i64.store (local.get $p) (local.get $value)))
  (func (export "publish") (param $p i32) (param $a i32) (param $b i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (i32.store (local.get $p) (local.get $a))
    (i32.store offset=4 (local.get $p) (local.get $b))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "reverse") (param $p i32) (param $a i32) (param $b i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (i32.store offset=4 (local.get $p) (local.get $b))
    (i32.store (local.get $p) (local.get $a))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "copy_tuple") (param $p i32) (param $source i32) (param $b i32)
    (local $frame i32) (local $a i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (local.set $a (i32.load (local.get $source)))
    (i32.store (local.get $p) (local.get $a))
    (i32.store offset=4 (local.get $p) (local.get $b))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "mixed_tuple") (param $p i32) (param $source i32)
    (local $frame i32) (local $a i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (i32.store8 (local.get $source) (i32.const 171))
    (i32.store16 offset=1 (local.get $source) (i32.const 52719))
    (local.set $a (i32.load (local.get $source)))
    (i32.store (local.get $p) (local.get $a))
    (i32.store offset=4 (local.get $p) (i32.const 287454020))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "wrapping_tuple") (param $p i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (i32.store (i32.add (local.get $p) (i32.const 4)) (i32.const 1432778632))
    (i32.store offset=4 (local.get $p) (i32.const 287454020))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "after_import") (param $kind i32) (param $p i32)
    (local $frame i32) (local $a i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (call $touch (local.get $kind))
    (local.set $a (i32.load (i32.const 32)))
    (i32.store (local.get $p) (local.get $a))
    (i32.store offset=4 (local.get $p) (i32.const 1432778632))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "grow_tuple") (param $p i32) (param $pages i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (drop (memory.grow (local.get $pages)))
    (i32.store (local.get $p) (i32.const 287454020))
    (i32.store offset=4 (local.get $p) (i32.const 1432778632))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16))))

  (func (export "loop_tuples") (param $kind i32) (param $p i32) (param $count i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (block $done
      (loop $again
        (br_if $done (i32.eqz (local.get $count)))
        (global.set $stack (local.get $frame))
        (call $touch (local.get $kind))
        (local.set $count (i32.sub (local.get $count) (i32.const 1)))
        (i32.store (local.get $p) (i32.const 287454020))
        (i32.store offset=4 (local.get $p) (i32.const 1432778632))
        (global.set $stack (i32.add (local.get $frame) (i32.const 16)))
        (br $again))))

  (func (export "conditional_tuple") (param $flag i32) (param $p i32)
    (local $frame i32)
    (local.set $frame (i32.sub (global.get $stack) (i32.const 16)))
    (global.set $stack (local.get $frame))
    (if (local.get $flag)
      (then (call $touch (i32.const 1)))
      (else (call $touch (i32.const 0))))
    (i32.store (local.get $p) (i32.const 287454020))
    (i32.store offset=4 (local.get $p) (i32.const 1432778632))
    (global.set $stack (i32.add (local.get $frame) (i32.const 16)))))
