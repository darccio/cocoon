(module
  (import "probe" "touch" (func $touch))
  (import "probe" "impure" (func $impure (param i32) (result i32)))
  (memory (export "memory") 1 3)
  (global $prefix (mut i32) (i32.const 0))
  (func (export "prefix") (result i32) (global.get $prefix))

  (func (export "covered") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "triple") (param $p i32) (result i32) (local $a i32) (local $b i32) (local $c i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=4 (local.get $p)))
    (local.set $b (i32.load offset=8 (local.get $p)))
    (local.set $c (i32.load (local.get $p)))
    (i32.add (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5)))
      (i32.mul (local.get $c) (i32.const 7))))
  (func (export "rising") (param $p i32) (result i32) (local $a i32) (local $b i32) (local $c i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load (local.get $p)))
    (local.set $b (i32.load offset=4 (local.get $p)))
    (local.set $c (i32.load offset=8 (local.get $p)))
    (i32.add (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5)))
      (i32.mul (local.get $c) (i32.const 7))))
  (func (export "rebind") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (local.set $p (i32.add (local.get $p) (i32.const 16)))
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "wrapped") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (local.set $b (i32.load (i32.add (local.get $p) (i32.const -16))))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "imported") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (call $touch)
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "stored") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (i32.store (local.get $p) (i32.const 999))
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "conditional") (param $p i32) (param $flag i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (if (local.get $flag) (then (local.set $a (i32.load offset=8 (local.get $p)))))
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "grown") (param $p i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (drop (memory.grow (i32.const 1)))
    (local.set $b (i32.load (local.get $p)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
  (func (export "two_bases") (param $p i32) (param $other i32) (result i32) (local $a i32) (local $b i32)
    (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
    (local.set $a (i32.load offset=8 (local.get $p)))
    (local.set $b (i32.load (local.get $other)))
    (i32.add (i32.mul (local.get $a) (i32.const 3)) (i32.mul (local.get $b) (i32.const 5))))
)
