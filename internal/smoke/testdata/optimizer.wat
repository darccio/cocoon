(module
  (memory (export "memory") 1 2)
  (func (export "finite_nonnegative") (param f64) (result i32)
    (i32.and
      (f64.ge (local.get 0) (f64.const 0))
      (f64.le (local.get 0) (f64.const 0x1.fffffffffffffp+1023))))
  (func (export "bits") (param f64) (result i64)
    (i64.reinterpret_f64 (local.get 0)))
  (func (export "min_zero") (param f64) (result i64)
    (i64.reinterpret_f64 (f64.min (local.get 0) (f64.const 0))))
  (func (export "max_zero") (param f64) (result i64)
    (i64.reinterpret_f64 (f64.max (local.get 0) (f64.const 0))))
  (func (export "rounding_order") (param f64) (result i64)
    (i64.reinterpret_f64
      (f64.add (f64.add (local.get 0) (f64.const 1e16)) (f64.const -1e16))))
  (func (export "guarded_load") (param i32 i32) (result i32)
    (if (result i32) (local.get 0)
      (then (i32.load (local.get 1)))
      (else (i32.const 42))))
  (func (export "eager_select") (param i32 i32) (result i32)
    (select (i32.const 42) (i32.load (local.get 1)) (local.get 0)))
  (func $mark (param i32) (result i32)
    (i32.store (i32.const 8)
      (i32.add (i32.mul (i32.load (i32.const 8)) (i32.const 10)) (local.get 0)))
    (local.get 0))
  (func (export "operand_order") (result i32)
    (i32.store (i32.const 8) (i32.const 0))
    (i32.add (call $mark (i32.const 1))
      (i32.add (call $mark (i32.const 2)) (call $mark (i32.const 3)))))
  (func (export "store_then_trap") (param i32)
    (i32.store (i32.const 0) (i32.const 1))
    (drop (i32.load (local.get 0)))
    (i32.store (i32.const 0) (i32.const 2)))
  (func (export "trap_then_store") (param i32)
    (drop (i32.load (local.get 0)))
    (i32.store (i32.const 0) (i32.const 3)))
  (func (export "divide") (param i32 i32) (result i32)
    (i32.div_s (local.get 0) (local.get 1)))
  (func (export "truncate") (param f64) (result i32)
    (i32.trunc_f64_s (local.get 0)))
  (func (export "empty_fill") (param i32)
    (memory.fill (local.get 0) (i32.const 0) (i32.const 0)))
)
